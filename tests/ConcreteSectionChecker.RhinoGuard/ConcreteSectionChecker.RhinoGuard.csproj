<Project Sdk="Microsoft.NET.Sdk">
  <!-- The GPC guard of ReBear.gha inside a real Rhino (Rhino.Inside), started by RegressionChecks.StaleBin where Rhino 8 is installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rhino.Inside" Version="8.0.7-beta" />
    <PackageReference Include="RhinoCommon" Version="8.27.26019.16021" ExcludeAssets="runtime" />
    <!-- Rhino's own copies are loaded at run time; Rhino.Inside alone would bring Grasshopper 8.0 into the output. -->
    <PackageReference Include="Grasshopper" Version="8.27.26019.16021" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
